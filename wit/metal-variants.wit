package l9o:gpu@0.1.0;

interface metal-variants {
  use compute.{command-list, error, op, params, tensor};

  record arm {
    lo: u32,
    hi: u32,
    name: string,
  }

  record-variant: func(
    cmds: borrow<command-list>,
    operation: op,
    ins: list<borrow<tensor>>,
    outs: list<borrow<tensor>>,
    name: string,
  ) -> result<_, error>;

  record-variant-rule: func(
    cmds: borrow<command-list>,
    space: borrow<params>,
    parameter: u8,
    arms: list<arm>,
    operation: op,
    ins: list<borrow<tensor>>,
    outs: list<borrow<tensor>>,
  ) -> result<_, error>;
}

world metal-host {
  import compute;
  import metal-variants;
}

world metal-variant-smoke {
  import compute;
  import metal-variants;
  export run: func() -> result<_, string>;
}
