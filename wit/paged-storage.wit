package l9o:gpu@0.1.0;

interface paged-storage {
  use compute.{affine, command-list, dtype, error, params, tensor};

  record variant-arm {
    lo: u32,
    hi: u32,
    name: string,
  }

  resource sequence;
  record slot-tensors {
    lanes: u32,
    logical-lengths: tensor,
    query-starts: tensor,
    absolute-positions: tensor,
  }
  resource batch-slot {
    tensors: func() -> result<slot-tensors, error>;
  }
  record state-plane-descriptor {
    dtype: dtype,
    shape: list<u32>,
  }
  resource page-pool {
    open-slot: func(planes: u32) -> result<batch-slot, error>;
    open-state-slot: func(planes: u32, state-planes: list<state-plane-descriptor>) -> result<batch-slot, error>;
  }

  enum state-operation {
    causal-convolution,
    delta-rule,
    delta-rule-block,
  }

  record-state: func(
    cmds: borrow<command-list>,
    slot: borrow<batch-slot>,
    lane: u32,
    plane: u32,
    operation: state-operation,
    inputs: list<borrow<tensor>>,
    output: borrow<tensor>,
    algorithm: string,
  ) -> result<_, error>;

  enum copy-direction {
    into-pages,
    out-of-pages,
  }

  record paged-span {
    plane: u32,
    start: affine,
    len: u64,
  }

  record sdpa-cfg {
    key-plane: u32,
    value-plane: u32,
    scale: f32,
    causal: bool,
    q-start: affine,
    key-length: affine,
    algorithm: string,
  }

  record-paged-copy: func(
    cmds: borrow<command-list>,
    slot: borrow<batch-slot>,
    lane: u32,
    span: paged-span,
    ordinary: borrow<tensor>,
    direction: copy-direction,
  ) -> result<_, error>;

  record-paged-sdpa: func(
    cmds: borrow<command-list>,
    slot: borrow<batch-slot>,
    lane: u32,
    query: borrow<tensor>,
    output: borrow<tensor>,
    config: sdpa-cfg,
  ) -> result<_, error>;

  select-paged-sdpa-variant-rule: func(
    cmds: borrow<command-list>,
    space: borrow<params>,
    parameter: u8,
    arms: list<variant-arm>,
  ) -> result<_, error>;

  record-paged-sdpa-append: func(
    cmds: borrow<command-list>,
    slot: borrow<batch-slot>,
    lane: u32,
    query: borrow<tensor>,
    key: borrow<tensor>,
    value: borrow<tensor>,
    output: borrow<tensor>,
    config: sdpa-cfg,
  ) -> result<_, error>;

}
