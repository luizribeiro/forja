package l9o:gpu@0.1.0;

interface compute {
  enum dtype {
    %f32,
    %f16,
    %bf16,
    %i32,
    %u32,
  }

  record slice-spec {
    start: u32,
    len: u32,
    step: u32,
  }

  record param-range {
    lo: u32,
    hi: u32,
  }

  record affine {
    param: option<u8>,
    scale: u32,
    offset: u32,
  }

  record param-slice {
    start: affine,
    len: affine,
    step: u32,
  }

  variant view-op {
    slice(list<slice-spec>),
    reshape(list<u32>),
    permute(list<u8>),
    broadcast(list<u32>),
  }

  record rope-cfg {
    theta: f32,
  }

  record sdpa-cfg {
    scale: f32,
    causal: bool,
    q-start: affine,
  }

  record sample-cfg {
    position: affine,
  }

  record quant-matmul-cfg {
    bits: u8,
    group-size: u32,
  }

  record top-k-cfg {
    k: u32,
  }

  enum program-kind {
    %map,
    row,
  }

  enum value-type {
    %f32,
    %u32,
    %bool,
  }

  enum unop {
    neg,
    abs,
    exp,
    log,
    sqrt,
    rsqrt,
    sin,
    cos,
    tanh,
    sigmoid,
    recip,
    floor,
  }

  enum binop {
    add,
    sub,
    mul,
    div,
    min,
    max,
    pow,
    lt,
    le,
    eq,
    ne,
    ge,
    gt,
  }

  enum redop {
    sum,
    max,
    min,
  }

  variant inst {
    input(u32),
    %const(f32),
    index(u8),
    extent(u8),
    unary(tuple<unop, u32>),
    binary(tuple<binop, u32, u32>),
    select(tuple<u32, u32, u32>),
    cast(tuple<value-type, u32>),
    reduce(tuple<redop, u32>),
  }

  record program-source {
    kind: program-kind,
    insts: list<inst>,
    outputs: list<tuple<u32, u32>>,
  }

  record kernel-signature {
    rank: u8,
    inputs: list<dtype>,
    outputs: list<dtype>,
    scalars: u8,
  }

  variant op {
    copy,
    add,
    silu-mul,
    rms-norm(f32),
    softmax,
    argmax,
    top-k(top-k-cfg),
    sample(sample-cfg),
    rope(rope-cfg),
    embed,
    matmul,
    gather-matmul,
    quant-matmul(quant-matmul-cfg),
    gather-quant-matmul(quant-matmul-cfg),
    sdpa(sdpa-cfg),
  }

  variant error {
    layout(string),
    op-signature(string),
    quota(string),
    backend-execution(string),
    invalid-handle(string),
  }

  record tensor-info {
    dtype: dtype,
    shape: list<u32>,
  }

  resource tensor {
    alloc: static func(dt: dtype, shape: list<u32>) -> result<tensor, error>;
    view: func(operation: view-op) -> result<tensor, error>;
    view-param: func(space: borrow<params>, slices: list<param-slice>) -> result<tensor, error>;
    write: func(bytes: list<u8>) -> result<_, error>;
    read: async func() -> result<list<u8>, error>;
  }

  resource weights {
    info: func(name: string) -> result<tensor-info, error>;
    tensor: func(name: string) -> result<tensor, error>;
    names: func() -> list<string>;
  }

  resource kernel {
    create: static func(src: program-source, sig: kernel-signature) -> result<kernel, error>;
  }

  resource params {
    constructor(ranges: list<param-range>);
  }

  resource command-list {
    constructor();
    dispatch: func(operation: op, ins: list<borrow<tensor>>, out: borrow<tensor>) -> result<_, error>;
    dispatch-many: func(operation: op, ins: list<borrow<tensor>>, outs: list<borrow<tensor>>) -> result<_, error>;
    dispatch-kernel: func(k: borrow<kernel>, ins: list<borrow<tensor>>, outs: list<borrow<tensor>>) -> result<_, error>;
  }

  resource graph {
    create: static func(cmds: command-list) -> result<graph, error>;
  }

  submit: async func(cmds: command-list) -> result<option<u64>, error>;
  replay: async func(g: borrow<graph>, values: list<u32>) -> result<option<u64>, error>;
  open-weights: func(grant: string) -> result<weights, error>;
}

world host {
  import compute;
}

world tensor-smoke {
  import compute;
  export run: async func() -> result<u64, string>;
}

world tensor-abuse {
  import compute;
  export run: async func() -> result<u64, string>;
  export large-dispatch-input: async func() -> result<_, string>;
  export large-read-refused: async func() -> result<_, string>;
  export churn-kernels: async func() -> result<u32, string>;
  export replay-churn: async func() -> result<u32, string>;
  export exhaust-graphs: async func() -> result<u32, string>;
  export rewrite-graph-buffer: async func() -> result<list<u8>, string>;
  export retained-graph-replay: async func() -> result<_, string>;
  export grow-memory: async func(bytes: u32) -> bool;
  export misuse-handle: async func();
}

world rmsnorm-smoke {
  import compute;
  export run: async func() -> result<tuple<u64, u64>, string>;
}

world program-smoke {
  import compute;
  export run: async func() -> result<list<f32>, string>;
  export exercise-explicit-kernel: async func() -> result<_, string>;
  export churn-program-cache: async func() -> result<_, string>;
  export exhaust-shared-quota: async func() -> result<_, string>;
}

world weights-smoke {
  import compute;
  export run: async func() -> result<list<u8>, string>;
}

world sdk-smoke {
  import compute;
  export run: async func(
    input: list<f32>,
    norm-weight: list<f32>,
    q-weight: list<f32>,
    k-weight: list<f32>,
    v-weight: list<f32>,
    output-weight: list<f32>,
  ) -> result<list<f32>, string>;
  export capture-replay: async func(value: u32) -> result<list<u32>, string>;
  export capture-refusals: async func() -> result<list<string>, string>;
}
