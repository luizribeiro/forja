package l9o:gpu@0.1.0;

interface compute {
  enum dtype {
    %f32,
    %f16,
    %bf16,
    %i32,
    %u32,
  }

  record slice-spec {
    start: u32,
    len: u32,
    step: u32,
  }

  variant view-op {
    slice(list<slice-spec>),
    reshape(list<u32>),
    permute(list<u8>),
    broadcast(list<u32>),
  }

  record rope-cfg {
    theta: f32,
  }

  record sdpa-cfg {
    scale: f32,
    causal: bool,
    q-start: u32,
  }

  variant op {
    copy,
    add,
    silu-mul,
    rms-norm(f32),
    softmax,
    rope(rope-cfg),
    embed,
    matmul,
    sdpa(sdpa-cfg),
  }

  variant error {
    layout(string),
    op-signature(string),
    quota(string),
    backend-execution(string),
    invalid-handle(string),
  }

  resource tensor {
    alloc: static func(dt: dtype, shape: list<u32>) -> result<tensor, error>;
    view: func(operation: view-op) -> result<tensor, error>;
    write: func(bytes: list<u8>) -> result<_, error>;
    read: async func() -> result<list<u8>, error>;
  }

  resource command-list {
    constructor();
    dispatch: func(operation: op, ins: list<borrow<tensor>>, out: borrow<tensor>) -> result<_, error>;
  }

  submit: async func(cmds: command-list) -> result<option<u64>, error>;
}

world host {
  import compute;
}

world tensor-smoke {
  import compute;
  export run: async func() -> result<u64, string>;
}

world tensor-abuse {
  import compute;
  export run: async func() -> result<u64, string>;
  export large-dispatch-input: async func() -> result<_, string>;
  export large-read-refused: async func() -> result<_, string>;
  export grow-memory: async func(bytes: u32) -> bool;
  export misuse-handle: async func();
}

world rmsnorm-smoke {
  import compute;
  export run: async func() -> result<tuple<u64, u64>, string>;
}
