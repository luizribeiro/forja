package l9o:gpu@0.1.0;

interface engine {
  use compute.{error, tensor, weights};

  record engine-info {
    vocab: u32,
    max-context: u32,
    tap-layers: list<u32>,
    router-layers: list<u32>,
  }

  record load-config {
    num-hidden-layers: option<u32>,
    replay: bool,
    tunings: list<string>,
    fixed-variant-picks: list<fixed-variant-pick>,
    variant-rule-picks: list<variant-rule-pick>,
  }

  record fixed-variant-pick {
    site: string,
    name: string,
  }

  record variant-rule-pick {
    site: string,
    parameter: string,
    arms: list<variant-arm>,
  }

  record variant-arm {
    lo: u32,
    hi: u32,
    name: string,
  }

  record step-in {
    tokens: list<u32>,
    start-pos: u32,
    taps: bool,
  }

  record step-out {
    logits: tensor,
    taps: list<tensor>,
    router-logits: list<tensor>,
  }

  record decode-in {
    tokens: option<list<u32>>,
    start-pos: u32,
    sampling: sampling-params,
  }

  record sampling-params {
    temperature: f32,
    top-k: u32,
    top-p: f32,
    seed: u64,
  }

  record decode-out {
    logits: tensor,
    token: tensor,
  }

  describe: func() -> engine-info;
  load: async func(w: borrow<weights>, config: load-config) -> result<_, error>;
  step: async func(input: step-in) -> result<step-out, error>;
  decode: async func(input: decode-in) -> result<decode-out, error>;
}

// This initial contract uses one sequence and engine-owned cache tensors.
// Paged caches, batches, and drafting replace it in the serving interface.
world engine-component {
  import compute;
  export engine;
}
